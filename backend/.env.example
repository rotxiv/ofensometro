# Port where the API will run
API_PORT=8000

#Configuration for PostgreSQL database, chage 'password' to your own password
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ofensometro

# Orígenes que pueden llamar a la API desde un navegador (frontend web, Flutter web).
# "*" sirve para desarrollar; en producción lista los dominios reales, separados por coma.
CORS_ORIGINS=*