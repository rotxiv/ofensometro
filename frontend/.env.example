# Copia este archivo como .env para cambiar la configuración. Todo es opcional.

# --- npm run dev / npm run preview (sin Docker) ---
# Dónde está la API. Por defecto: http://127.0.0.1:8000
VITE_API_TARGET=http://127.0.0.1:8000

# --- docker compose (con Docker) ---
# Dirección de la API vista desde el contenedor, SIN barra final.
#   API en el equipo (Windows, macOS y Linux):  http://host.docker.internal:8000
#   API en otro contenedor de la misma red:      http://api:8000   (nombre del servicio)
API_UPSTREAM=http://host.docker.internal:8000
# Puerto donde se publica la web
WEB_PORT=8080
